{
  "name": "jitter",
  "productName": "Jitter",
  "version": "0.1.0",
  "private": true,
  "description": "Mantiene tu estado activo mientras trabajas: simula actividad cada pocos minutos.",
  "author": "Jhovanny Linares",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "icon": "electron build/icono.mjs",
    "familia": "node scripts/copiar-familia.mjs",
    "dist": "electron-vite build && electron-builder --win",
    "e2e": "electron-vite build && python tests/e2e/flujo.py",
    "e2e:pack": "electron-vite build && electron-builder --win --dir && python tests/e2e/flujo.py pack"
  },
  "dependencies": {
    "@fontsource/open-sans": "5.2.5",
    "koffi": "3.3.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.8.7",
    "electron-builder": "26.17.0",
    "electron-vite": "5.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "allowScripts": {
    "electron@43.8.7": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true,
    "koffi@3.3.6": true
  }
}
